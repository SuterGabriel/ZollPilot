<?xml version="1.0" encoding="UTF-8"?>
<!-- Erzeugt aus einer Prozessbeschreibung (docs/prozess/README.md), nicht gezeichnet.
     Gestrichelt gedachte Schritte tragen "(vorgesehen)" im Namen und eine
     documentation; BPMN kennt keinen Status, das Repo schon. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_ZollPilot" targetNamespace="https://github.com/SuterGabriel/ZollPilot" exporter="ZollPilot" exporterVersion="0.1.0">
  <bpmn:collaboration id="Collaboration_Sendungsakte">
    <bpmn:participant id="Participant_Sendungsakte" name="Sendungsakte: Vollständigkeits- und Konsistenzprüfung vor der Ausfuhr" processRef="Process_Sendungsakte" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Sendungsakte" name="Sendungsakte" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Lieferant" name="Lieferant / Verkäufer">
        <bpmn:flowNodeRef>Rechnung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Nachliefern</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Spediteur" name="Spediteur / Carrier">
        <bpmn:flowNodeRef>BL</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sach" name="Sachbearbeitung Export">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Mail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Einreichen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ende</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Uebersteuern</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Versenden</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ZollPilot" name="ZollPilot">
        <bpmn:flowNodeRef>Lesen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Pruefen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Freigabereif</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Formulieren</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Eskalieren</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Zuordnen</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Zoll" name="Zollvertreter / Zollverwaltung">
        <bpmn:flowNodeRef>Anmelden</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Sendung angelegt">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Mail" name="E-Mail mit Anhängen empfangen">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Rechnung" name="Rechnung und Packliste ausstellen">
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="BL" name="B/L ausstellen (Entwurf, dann final)">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Einreichen" name="Stammdaten angeben, Belege einreichen">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Lesen" name="Lesen und klassifizieren (Textlayer oder OCR)">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Pruefen" name="Akte bauen, Pflichtmatrix und Regeln prüfen">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Freigabereif" name="freigabereif?">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Anmelden" name="Ausfuhranmeldung, ABD mit MRN">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Ende" name="Akte konsistent">
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Formulieren" name="Nachforderung formulieren (Feld, Grund, Adressat)">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Uebersteuern" name="Übersteuern mit Name und Begründung">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Eskalieren" name="Erinnerung und Eskalation vor Cut-off">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Versenden" name="Nachforderung versenden">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Nachliefern" name="Fehlenden Wert nachliefern">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Zuordnen" name="Antwort der Akte zuordnen">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="Start" targetRef="Rechnung" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="BL" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Start" targetRef="Mail" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Rechnung" targetRef="Einreichen" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="BL" targetRef="Einreichen" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Mail" targetRef="Zuordnen" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Einreichen" targetRef="Lesen" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Lesen" targetRef="Pruefen" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Pruefen" targetRef="Freigabereif" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Freigabereif" targetRef="Anmelden" name="ja" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Anmelden" targetRef="Ende" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Freigabereif" targetRef="Formulieren" name="nein" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Freigabereif" targetRef="Uebersteuern" name="verantworten" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Uebersteuern" targetRef="Pruefen" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Formulieren" targetRef="Eskalieren" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Eskalieren" targetRef="Versenden" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Versenden" targetRef="Nachliefern" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Nachliefern" targetRef="Mail" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Zuordnen" targetRef="Lesen" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Nachliefern" targetRef="Einreichen" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_Sendungsakte">
