# Kopieren nach .env. Die Werte hier sind Entwicklungswerte und stehen im Repo;
# für jeden anderen Betrieb ersetzen (docs/BETRIEB.md).
#
# Achtung: deploy/n8n/credentials.json trägt dasselbe Postgres-Passwort, damit
# der Import beim ersten Start funktioniert. Wer es hier ändert, ändert es dort.

POSTGRES_USER=zollpilot
POSTGRES_PASSWORD=zollpilot-dev
POSTGRES_PORT=5432

N8N_VERSION=1.114.0
N8N_PORT=5678
N8N_HOST=localhost
WEBHOOK_URL=http://localhost:5678/
N8N_ENCRYPTION_KEY=nur-fuer-lokale-entwicklung-ersetzen

EXTRAKTION_PORT=8765
OBERFLAECHE_PORT=8088

# Post: GreenMail als Demo-Postfach (ADR-009), Schnittstelle, SMTP, IMAP
GREENMAIL_API_PORT=8025
GREENMAIL_SMTP_PORT=3025
GREENMAIL_IMAP_PORT=3143

# Monitoring (docs/BETRIEB.md, Abschnitt Alarme)
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3000
GRAFANA_PASSWORT=zollpilot-dev
